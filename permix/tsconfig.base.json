{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts"],
  "exclude": [
    "src/react/*.ts",
    "src/react/*.tsx",
    "src/solid/*.ts",
    "src/solid/*.tsx",
    "src/next/*.ts",
    "src/next/*.tsx",
    "src/tanstack-start/*.ts",
    "src/tanstack-start/*.tsx",
    "src/svelte/**/*.ts",
    "src/svelte/**/*.svelte"
  ]
}
