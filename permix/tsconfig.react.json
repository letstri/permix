{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "react",
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/react/*.ts", "src/react/*.tsx", "src/next/*.ts", "src/next/*.tsx", "src/tanstack-start/*.ts", "src/tanstack-start/*.tsx"],
  "exclude": ["src/solid/*.ts", "src/solid/*.tsx"]
}
